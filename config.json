{
    "dashboard": {
        "host": "127.0.0.1",
        "port": 8090,
        "open_browser": true,
        "ui_refresh_seconds": 5
    },
    "collection": {
        "interval_minutes": 15,
        "command_timeout_seconds": 240,
        "parallel": true,
        "log_tail_lines": 60,
        "skip_sections": []
    },
    "hosts": [
        { "name": "A-SMS",   "ip": "10.1.1.101", "role": "Management" },
        { "name": "A-GW-01", "ip": "10.1.1.2",   "role": "Gateway" },
        { "name": "A-GW-02", "ip": "10.1.1.3",   "role": "Gateway" }
    ],
    "ignore": {
        "component_attributes": "(?i)(time|date|last|next|check)",
        "line_patterns": [
            "^CLINFR",
            "(?i)^(last|next) (check|update)",
            "(?i)database lock",
            "(?i)^retrieving"
        ]
    }
}
